# Copy to `.env` and fill in real values (`.env` is gitignored).
PORT=4000

# REQUIRED for production: a long random string, e.g. `openssl rand -hex 32`.
# The dev default in config.js is fine for local development only.
SESSION_SECRET=change-me

# SQLite file location (default: ./db/app.sqlite)
# DB_PATH=./db/app.sqlite
