# Copy to `.env` and fill in real values (`.env` is gitignored).
PORT=4000

# REQUIRED for production: a long random string, e.g. `openssl rand -hex 32`.
# The dev default in config.js is fine for local development only.
SESSION_SECRET=change-me

# SQLite file location (default: ./db/app.sqlite)
# DB_PATH=./db/app.sqlite

# Coach account, created by `npm run seed -w server`.
# Leave COACH_PASSWORD unset only for local dev (a default dev password is used).
COACH_USERNAME=coach
COACH_PASSWORD=change-me-to-something-long
